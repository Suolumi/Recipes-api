        ],
        "tags": [
          "Users"
        ],
        "summary": "Get profile picture",
        "parameters": [
          {
            "type": "string",
            "example": "6567bd0a84f663dbe91176f5.png",
            "description": "Id of the picture with the extension",
            "name": "id",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Jpeg, png or jpg image"
          },
          "404": {
            "description": "Not found"
          }
        }
