    "/recipes": {
      "get": {
        "description": "Get multiple recipe previews with query parameters",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "Recipes"
        ],
        "summary": "Get Recipes (preview)",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "type": "integer"
          },
          {
            "name": "offset",
            "in": "query",
            "type": "integer"
          },
          {
            "name": "author",
            "in": "query",
            "type": "string"
          },
          {
            "name": "title",
            "in": "query",
            "type": "string"
          },
          {
            "name": "preparation_time",
            "in": "query",
            "type": "integer"
          },
          {
            "name": "total_time",
            "in": "query",
            "type": "integer"
          },
          {
            "name": "ingredients",
            "in": "query",
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "csv"
          },
          {
            "name": "kind",
            "in": "query",
            "type": "string",
            "enum": [
              "snack",
              "starter",
              "dish",
              "side-dish",
              "sauce",
              "dessert",
              "drink",
              "plate"
            ]
          },
          {
            "name": "locale",
            "in": "query",
            "type": "string",
            "description": "One BCP 47 locale. Missing or stale stored translations are refreshed; failures fall back per recipe to canonical."
          },
          {
            "name": "search_locale",
            "in": "query",
            "type": "string",
            "description": "Optional BCP 47 locale used for title and ingredient substring matching. When omitted, canonical recipe fields are searched."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/models.GetRecipesResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/models.ErrorResponse"
            }
          },
          "401": {
            "description": "Invalid or expired jwt",
            "schema": {
              "$ref": "#/definitions/models.ErrorResponse"
            }
          },
          "500": {
            "description": "Failed to get the recipes",
            "schema": {
              "$ref": "#/definitions/models.ErrorResponse"
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Create a complete recipe. Send application/json without new pictures, or multipart/form-data with a recipe JSON field and repeated pictures file fields.",
        "consumes": [
          "application/json",
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "Recipes"
        ],
        "summary": "Create Recipe",
        "parameters": [
          {
            "description": "Recipe information",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/models.CreateRecipe"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "type": "string",
            "description": "Optional retry key retained for 24 hours"
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/models.ErrorResponse"
            }
          },
          "401": {
            "description": "Invalid or expired jwt",
            "schema": {
              "$ref": "#/definitions/models.ErrorResponse"
            }
          },
          "500": {
            "description": "Failed to create the recipe",
            "schema": {
              "$ref": "#/definitions/models.ErrorResponse"
            }
          },
          "201": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/models.Recipe"
            }
          },
          "413": {
            "description": "Request too large"
          },
          "415": {
            "description": "Unsupported content type"
          },
          "422": {
            "description": "Incomplete recipe or invalid picture",
            "schema": {
              "$ref": "#/definitions/models.ErrorResponse"
            }
          }
        }
      }
    },
